// ============================================================================
// THEME — Luxury Residential Portfolio
// Color palette, typography tokens, and reusable layout constants.
// ============================================================================

// ---- Color palette ----------------------------------------------------------
// A restrained, editorial palette: deep navy + warm gold on an ivory ground.

#let navy        = rgb("#1A2238")   // Primary headline / rules
#let navy-soft   = rgb("#2E3A59")   // Body copy on cream when emphasis needed
#let gold        = rgb("#C8A96A")   // Accent — warm metallic
#let gold-dark   = rgb("#9B7D3E")   // Links, secondary accents
#let cream       = rgb("#FAF7F2")   // Page background (ivory)
#let cream-deep  = rgb("#F0EADF")   // Card background
#let charcoal    = rgb("#2B2B2B")   // Body text
#let slate       = rgb("#6B6B6B")   // Muted captions / metadata
#let hairline    = rgb("#D9CFBE")   // Subtle dividers

// ---- Typography -------------------------------------------------------------
// Matches fonts already used in the main CV build so no new files are needed.

#let body-font    = ("Source Sans 3", "Source Sans Pro", "Helvetica", "Arial")
#let heading-font = ("Roboto", "Source Sans 3", "Helvetica", "Arial")
#let display-font = ("Roboto", "Source Sans 3", "Helvetica", "Arial")

// ---- Layout tokens ----------------------------------------------------------
#let gutter     = 18pt
#let rule-thin  = 0.5pt
#let rule-thick = 1.25pt
