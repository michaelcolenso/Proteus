// ----------------------------------------------------------------------------
#project-case(
  title: "Temple Lofts — Historic Masonic Temple",
  location: "Long Beach, CA",
  value: "$25M",
  year: "2006",
  role: "Project Engineer → Project Manager",
  scope: [Seismic retrofit and full renovation of a historic Masonic Temple, converting ceremonial spaces into luxury loft apartments while preserving character-defining interior features.],
  challenge: [A complex seismic retrofit of unreinforced masonry, integration of modern MEP systems without compromising ornate plasterwork, and a regulatory environment requiring historic tax credits and SHPO review.],
